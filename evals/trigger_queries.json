{
  "name": "omneity-trigger-coverage",
  "version": "0.2.0",
  "purpose": "Evaluate whether realistic user-intent prompts trigger the single Omneity skill and route to the right internal departments.",
  "skills_under_test": ["omneity"],
  "queries": [
    {
      "id": "router-001",
      "category": "capability-routing",
      "query": "Which Omneity capability should I use to build an assistant that can search docs, answer in Arabic, and automate a website?",
      "expected_skills": ["omneity"],
      "expected_departments": ["functionality", "chat", "semango", "herd"]
    },
    {
      "id": "router-002",
      "category": "capability-routing",
      "query": "Give me a map of the departments available in these skills before I pick an API.",
      "expected_skills": ["omneity"],
      "expected_departments": ["functionality"]
    },
    {
      "id": "router-003",
      "category": "capability-routing",
      "query": "I do not know the product names. I need to choose between hosted AI, browser automation, and local search.",
      "expected_skills": ["omneity"],
      "expected_departments": ["functionality", "chat", "herd", "semango"]
    },
    {
      "id": "api-chat-001",
      "category": "chat-generation",
      "query": "Build a multilingual chat backend that streams assistant responses and keeps my API key server-side.",
      "expected_skills": ["omneity"],
      "expected_departments": ["chat", "app-patterns"]
    },
    {
      "id": "api-chat-002",
      "category": "chat-generation",
